generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  congregation String
  phone       String?
  cellphone   String?   // Celular
  address     String?   // Endereço
  birthDate   String?   // Data de Nascimento
  baptismDate String?   // Data de Batismo
  class       String?   // "Outras Ovelhas" ou "Ungido"
  gender      String   @default("male")
  accessLevel String   @default("viewer")
  privileges  String[] @default(["publisher"])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  territoryDesignations TerritoryDesignation[]
  meetingDesignations   MeetingDesignation[]
  reports               Report[]

  @@map("users")
}

model Territory {
  id            String   @id @default(cuid())
  number        Int      @unique
  name          String
  group         String
  type          String
  address       String
  latitude      Float
  longitude     Float
  status        String   @default("available")
  visits        Int      @default(0)
  assignedTo    Int?
  assignedToName String?
  areaKm2       Float?
  perimeter     Float?
  bordersNorth  String?
  bordersSouth  String?
  bordersEast   String?
  bordersWest   String?
  imageUrl      String?
  mapId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  designations  TerritoryDesignation[]

  @@map("territories")
}

// Designações de Território (já existente)
model TerritoryDesignation {
  id          Int      @id @default(autoincrement())
  territoryId String
  userId      Int
  assignedAt  DateTime @default(now())
  status      String   @default("pending") // pending, accepted, rejected, completed
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  territory   Territory @relation(fields: [territoryId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@map("territory_designations")
}

// Designações de Reunião (NOVO)
model MeetingDesignation {
  id          Int      @id @default(autoincrement())
  date        DateTime // Data da reunião
  meetingType String   @default("midweek") // "midweek" | "weekend"
  section     String   // "Tesouros da Palavra de Deus", "Faça seu melhor no ministério", "Nossa vida cristã"
  partNumber  String   // "1", "2", "3"... 
  partName    String   // Nome da parte
  speaker     String   // Nome do designado
  assistant   String?  // Nome do ajudante (opcional)
  time        String?  // "10 min", "4 min"...
  song        String?  // Número do cântico
  notes       String?  // Observações adicionais
  order       Int      @default(0) // Ordem de exibição
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("meeting_designations")
}

model Report {
  id          Int      @id @default(autoincrement())
  userId      Int
  month       String
  hours       Int      @default(0)
  visits      Int      @default(0)
  studies     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, month])
  @@map("reports")
}